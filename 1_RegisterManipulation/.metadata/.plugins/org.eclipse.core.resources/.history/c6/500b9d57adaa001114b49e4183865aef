//Register Definition//

#define uint32_t GPIOC_BASE =0x40020800UL
#define uint32_t RCC_BASE=0x40023800UL
#define uint32_t AHB1_OFFSET=0x30UL
#define uint32_t RCC_AHB1_ENR= (*(volatile unsigned int*)(RCC_BASE + AHB1_OFFSET)
#define uint32_t GPIO_MODER_OFFSET =0x00UL
#define uint32_t GPIOC_MODER_BASE=(*(volatile unsigned int*)(GPIOC_BASE+GPIO_MODER_OFFSET))
#define uint32_t GPIO_ODR_OFFSET=0x14UL
#define uint32_t GPIOC_ODR_BASE=(*(volatile unsinged int*)(GPIOC_BASE+GPIO_ODR_OFFSET))

int main (){

	//RCC and GPIOC Configurations//
	RCC_AHB1_ENR = (RCC_AHB1_ENR|(1<<2));
	GPIOC_MODER_BASE=(GPIOC_MODER_BASE|(10<<26));

	//infinite loop//
	while(1){
		GPIOC_ODR_BASE= (GPIOC_ODR |(1<<13));

	}


}
